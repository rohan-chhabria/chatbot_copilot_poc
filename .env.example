# LLM Providers — set LLM_PROVIDER to "openai" (recommended) or "gemini"
OPENAI_API_KEY=sk-proj-...
GEMINI_API_KEY=AIzaSy...
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.1

# Tenant DB Configs (JSON map: customer_key → connection params)
# Each tenant has its own Aurora MySQL reader endpoint
TENANT_DB_MAP={"demo":{"host":"demo-db.cluster-ro-xxx.us-east-1.rds.amazonaws.com","database":"Demo_aurora","user":"Demo_aurora","password":"xxx","port":3306}}

# Valkey / Redis (Session Store)
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_DB=0
SESSION_TTL_SECONDS=3600

# DynamoDB (Conversation History)
CONVERSATION_TABLE=InmateCopilot-Conversations-local
AWS_DEFAULT_REGION=us-east-1

# ChromaDB (Vector Store)
CHROMA_STORAGE_DIR=./chroma_db
VANNA_COLLECTION_NAME=inmate_copilot
VANNA_MODEL_NAME=inmate_copilot_v1

# Application
MAX_QUERY_RESULTS=500
MAX_CONVERSATION_TURNS=15
ENABLE_GUARDRAILS=true
LOG_LEVEL=INFO

# Deployment
ENVIRONMENT=dev
DEPLOYMENT_ID=a1b2c3d4e5
